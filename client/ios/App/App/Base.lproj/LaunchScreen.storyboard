        <scene sceneID="EHf-IW-A2E">
            <objects>
                <viewController id="01J-lp-oVM" sceneMemberID="viewController">
                    <!-- Plain #f7f9f8 root view (GrowLink Mobile's established page-background
                         token — same value as capacitor.config.ts's backgroundColor,
                         plugins.SplashScreen.backgroundColor, plugins.StatusBar.backgroundColor,
                         body.native-shell in index.css, and SceneDelegate.swift's window
                         fallback) with a single centered image view showing the Linked Leaf
                         icon (the exact same asset as AppIcon.appiconset — see
                         Assets.xcassets/Splash.imageset), constrained to 50% of the view's
                         width with a 1:1 aspect ratio (contentMode="scaleAspectFit", so it
                         can never stretch or crop) and centered both axes. This same
                         storyboard is what both the OS-level launch screen AND
                         @capacitor/splash-screen's own overlay render (see
                         SplashScreen.swift's buildViews(), which instantiates this exact
                         file) — one asset, one layout, so there is nothing for the two
                         stages to visibly disagree about. -->
                    <view key="view" contentMode="scaleToFill" id="Ydg-fD-yQX">
                        <rect key="frame" x="0.0" y="0.0" width="375" height="667"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
