# Environment for the dedicated iOS web build (npm run build:ios --
# vite.ios.config.ts), loaded via Vite's `--mode ios` env-file resolution
# (.env.ios overrides .env for that one build only; see
# https://vitejs.dev/guide/env-and-mode).
#
# Committed intentionally, unlike client/.env: every value below is
# public-safe. VITE_SUPABASE_ANON_KEY is Supabase's publishable anon key,
# designed to ship inside client bundles (RLS policies are what actually
# authorize access, not this key's secrecy) — it is the same key already
# embedded in the public web bundle today. VITE_API_BASE_URL and
# VITE_SUPABASE_URL are both public endpoints. No service-role key, APNs
# key, or other server secret belongs in this file or anywhere else under
# client/ — see CLAUDE.md.
VITE_SUPABASE_URL=https://revkaepkvgfeumtykibq.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_f2Nie8oGGSX5KJWl-2Gahw_DAg4H4T5
VITE_API_BASE_URL=https://growlinkserver-production.up.railway.app
