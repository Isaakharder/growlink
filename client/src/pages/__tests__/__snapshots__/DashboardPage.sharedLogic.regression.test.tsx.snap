exports[`desktop Yield by Color — pinned values > markup is unchanged, byte for byte 1`] = `"<div class="coming-soon-card dashboard-yield-card"><h2>Yield by Color</h2><p class="dashboard-section-subtitle">Total kg/m2 by color.</p><div class="dashboard-card-grid dashboard-yield-color-row" style="--dashboard-card-columns: 4;"><div class="dashboard-yield-color-pill"><span class="color-badge red">Red</span><div class="dashboard-yield-color-metrics"><div class="dashboard-yield-color-metric"><span class="dashboard-yield-color-metric-label">Harvested</span><span class="dashboard-yield-color-metric-value">2.17 kg/m2</span></div><div class="dashboard-yield-color-metric"><span class="dashboard-yield-color-metric-label">Shipped (kg/m²)</span><span class="dashboard-yield-color-metric-value">0.35 kg/m2</span></div></div></div><div class="dashboard-yield-color-pill"><span class="color-badge orange">Orange</span><div class="dashboard-yield-color-metrics"><div class="dashboard-yield-color-metric"><span class="dashboard-yield-color-metric-label">Harvested</span><span class="dashboard-yield-color-metric-value">—</span></div><div class="dashboard-yield-color-metric"><span class="dashboard-yield-color-metric-label">Shipped (kg/m²)</span><span class="dashboard-yield-color-metric-value">—</span></div></div></div><div class="dashboard-yield-color-pill"><span class="color-badge yellow">Yellow</span><div class="dashboard-yield-color-metrics"><div class="dashboard-yield-color-metric"><span class="dashboard-yield-color-metric-label">Harvested</span><span class="dashboard-yield-color-metric-value">—</span></div><div class="dashboard-yield-color-metric"><span class="dashboard-yield-color-metric-label">Shipped (kg/m²)</span><span class="dashboard-yield-color-metric-value">—</span></div></div></div><div class="dashboard-yield-color-pill"><span class="color-badge green">Green</span><div class="dashboard-yield-color-metrics"><div class="dashboard-yield-color-metric"><span class="dashboard-yield-col