exports[`desktop Greenhouse Snapshot — pinned values > markup is unchanged, byte for byte 1`] = `"<div class="coming-soon-card"><h2>Greenhouse Snapshot</h2><p class="dashboard-section-subtitle">Latest irrigation readings by zone.</p><div class="dashboard-snapshot-rows"><div class="dashboard-snapshot-row" style="--dashboard-snapshot-row-columns: 3;"><article class="dashboard-snapshot-card"><div class="dashboard-snapshot-title-row"><h3>Zone A</h3><span class="dashboard-snapshot-type-badge">Zone</span></div><div class="dashboard-snapshot-columns"><div class="dashboard-snapshot-column"><div class="dashboard-snapshot-metric"><span class="dashboard-snapshot-label">Feed EC</span><span class="dashboard-snapshot-value">2.46</span></div><div class="dashboard-snapshot-metric"><span class="dashboard-snapshot-label">Feed pH</span><span class="dashboard-snapshot-value">5.8</span></div></div><div class="dashboard-snapshot-column"><div class="dashboard-snapshot-metric"><span class="dashboard-snapshot-label">Drain EC</span><span class="dashboard-snapshot-value">3.14</span></div><div class="dashboard-snapshot-metric"><span class="dashboard-snapshot-label">Drain pH</span><span class="dashboard-snapshot-value">—</span></div></div><div class="dashboard-snapshot-column"><div class="dashboard-snapshot-metric"><span class="dashboard-snapshot-label">Avg Feed ml</span><span class="dashboard-snapshot-value">200</span></div><div class="dashboard-snapshot-metric"><span class="dashboard-snapshot-label">Drain %</span><span class="dashboard-snapshot-value">8.57%</span></div></div></div><div class="dashboard-snapshot-footer"><span class="dashboard-snapshot-label">Last Reading</span><span class="dashboard-snapshot-value dashboard-snapshot-date">2026-08-11</span></div></article><article class="dashboard-snapshot-card"><div class="dashboard-snapshot-title-row"><h3>Zone B</h3><span class="dashboard-snapshot-type-badge">Zone</span></div><div class="dashboard-snapshot-columns"><div class="dashboard-snaps