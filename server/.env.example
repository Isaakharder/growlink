PORT=4000
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated list of allowed browser origins in production.
# Example: CORS_ORIGINS=https://growlink.ca,https://www.growlink.ca
CORS_ORIGINS=
# Comma-separated list of Supabase user UUIDs that are allowed to use admin endpoints.
# Find a user's UUID in the Supabase dashboard under Authentication > Users.
# Example: ADMIN_USER_IDS=00000000-0000-0000-0000-000000000001,00000000-0000-0000-0000-000000000002
ADMIN_USER_IDS=
