PORT=4000
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Public web address used when building invite links (the canonical one,
# if the web app is served from more than one address).
# Example: APP_URL=https://growlink.lltech.io
APP_URL=
# Optional explicit Supabase redirect URL for invite emails. Must also be in
# Supabase Auth > URL Configuration > Redirect URLs.
# Example: SUPABASE_INVITE_REDIRECT_TO=https://growlink.lltech.io/invite/accept
SUPABASE_INVITE_REDIRECT_TO=
# Comma-separated browser origins allowed to call the API: every web address
# the app is served from. Each entry is reduced to scheme://host[:port], so a
# trailing slash or path is harmless; wildcards are not supported. Local dev
# servers and the iOS app (capacitor://localhost) are always allowed.
# Example: CORS_ORIGINS=https://growlink.lltech.io,https://growlinkclient-production.up.railway.app
CORS_ORIGINS=
# Comma-separated list of Supabase user UUIDs that are allowed to use admin endpoints.
# Find a user's UUID in the Supabase dashboard under Authentication > Users.
# Example: ADMIN_USER_IDS=00000000-0000-0000-0000-000000000001,00000000-0000-0000-0000-000000000002
ADMIN_USER_IDS=
