{
  "name": "growlink-server",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test:pdf": "node --require tsx/cjs --test src/utils/__tests__/flowMasterPdfParser.test.ts",
    "test:food-safety": "node --require dotenv/config --require tsx/cjs --test src/routes/foodSafety/services/__tests__/orgScopedTable.test.ts src/routes/foodSafety/__tests__/validation.test.ts src/routes/foodSafety/__tests__/permissions.test.ts",
    "test:food-safety-db": "node --require dotenv/config --require tsx/cjs --test src/routes/foodSafety/__tests__/dbIntegration.test.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.8",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.1",
    "express-rate-limit": "^7.5.1",
    "multer": "^2.1.1",
    "pdf-parse": "^2.4.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.8.6",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
