{
  "name": "growlink",
  "private": true,
  "scripts": {
    "dev": "concurrently -n server,client,forecasting \"npm run dev:server\" \"npm run dev:client\" \"npm run dev:forecasting\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "dev:forecasting": "cd forecasting && uvicorn app.main:app --reload --host 0.0.0.0 --port 8000"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
